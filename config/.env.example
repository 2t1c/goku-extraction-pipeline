# Goku Extraction Pipeline — environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# Notion ─────────────────────────────────────────────────────────
# 1. Create an internal integration at https://notion.so/my-integrations
# 2. Grant it access to your Evergreen Backlog database (and the parent video pages
#    if they live elsewhere)
# 3. Copy the token here (starts with ntn_ or secret_)
NOTION_TOKEN=ntn_REPLACE_ME

# Data source ID of your Evergreen Backlog database.
# Open the database in a browser; the 32-char hex in the URL is the database_id.
# Use that as NOTION_EVERGREEN_DS_ID.
NOTION_EVERGREEN_DS_ID=REPLACE_ME_32_HEX

# Typefully ──────────────────────────────────────────────────────
# Settings → API → create or copy your API key
TYPEFULLY_API_KEY=REPLACE_ME

# Find your social set ID:
#   GET https://api.typefully.com/v1/social-sets (using your API key)
# Or look at the URL when viewing the social set in the Typefully UI.
TYPEFULLY_SOCIAL_SET_ID=151393  # GeniusGTX as default — change for your account

# Clip paths ─────────────────────────────────────────────────────
# Source videos: cached in $HOME (large 500–1500 MB files; deep-nested is fine).
SOURCES_DIR=$HOME/ytclipper-fast/sources

# Output clips: user-facing — these get drag-dropped into Typefully drafts manually.
# Default puts them on the Desktop in plain sight. Override if you prefer elsewhere.
CLIPS_DIR=$HOME/Desktop/AI Agents/clips

# Tool paths (override only if you need to)
YTDLP=/opt/homebrew/bin/yt-dlp
FFMPEG=/opt/homebrew/bin/ffmpeg
